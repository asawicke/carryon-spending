# Copy to .env only if missing; the server loads it automatically.
# Never commit .env or use a VITE_ prefix. Environment variables take precedence.
IGNAV_API_KEY=
FLIGHT_PROVIDER=ignav
# Counts all attempts, including failures and booking-link requests; resets at midnight UTC.
# The provider's 1,000 free requests are ONE TIME, not a monthly allowance.
IGNAV_DAILY_LIMIT=20
# Optional, separate live-status provider. Not needed for Ignav fare search.
AIRLABS_API_KEY=
# A conservative per-installation monthly guard; AirLabs' free plan is personal use.
AIRLABS_MONTHLY_LIMIT=900
# Optional: use a separate database or port.
# CARRYON_DB_PATH=/absolute/path/to/carryon.sqlite3
# PORT=5050

# Set true only when serving over HTTPS; localhost HTTP uses false.
# COOKIE_SECURE=true

# Optional Google Identity Services web client ID (public identifier, not a secret).
# Configure authorized JavaScript origins first; see docs/GOOGLE_SIGN_IN.md.
GOOGLE_CLIENT_ID=

# Hosted production only. Keep local SQLite by leaving DATABASE_URL unset.
# Configure these in Azure App Service settings, never in the client bundle.
# DATABASE_URL=postgresql://user:password@server:5432/carryon?sslmode=verify-full
# CARRYON_ENV=production
# PUBLIC_ORIGIN=https://your-app.azurewebsites.net
